datasource db {
  provider = "postgresql"
}

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = ""
  previewFeatures        = ["partialIndexes", "relationJoins"]
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  ownedCompanies Company[]           @relation("CompanyOwner")
  ownedContacts  Contact[]           @relation("ContactOwner")
  ownedDeals     Deal[]              @relation("DealOwner")
  activities     Activity[]          @relation("ActivityAuthor")
  mailboxSyncs   MailboxSync[]
  factDecisions  ContactFact[]       @relation("FactDecider")
  conversations  AgentConversation[] @relation("ConversationOwner")
  fieldValues    FieldValue[]        @relation("FieldValueUser")
  savedViews     SavedView[]         @relation("SavedViewOwner")

  createdAgentDefinitions AgentDefinition[]             @relation("AgentDefinitionCreator")
  createdAgentVersions    AgentVersion[]                @relation("AgentVersionCreator")
  createdAgentTriggers    AgentTrigger[]                @relation("AgentTriggerCreator")
  initiatedAgentRuns      AgentRun[]                    @relation("AgentRunInitiator")
  agentAuditEvents        AgentAuditEvent[]             @relation("AgentAuditActor")
  conversationShares      AgentConversationShare[]      @relation("ConversationShareCreator")
  conversationSubmissions AgentConversationSubmission[] @relation("ConversationSubmissionAuthor")
  conversationFeedback    AgentConversationFeedback[]   @relation("ConversationFeedbackAuthor")
  slackMemberMatches      SlackMemberMatch[]
  slackConnections        SlackConnection[]             @relation("SlackConnectionInstaller")
  connectedMcpConnections McpConnection[]               @relation("McpConnectionUser")
  mcpOauthStates          McpOauthState[]               @relation("McpOauthStateUser")

  members     Member[]
  invitations Invitation[]

  onboardingSessions OnboardingSession[]

  ssoproviders SsoProvider[]

  apiKeys Apikey[]

  @@unique([email])
  @@map("user")
}

model SlackMemberMatch {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id          String   @id @default(cuid())
  crmUserId   String
  crmUser     User     @relation(fields: [crmUserId], references: [id], onDelete: Cascade)
  slackUserId String?
  slackHandle String?
  slackEmail  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, crmUserId])
  @@index([slackUserId])
  @@map("slackMemberMatch")
}

model SlackChannel {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id                String
  name              String
  memberCount       Int?
  available         Boolean   @default(true)
  isPrivate         Boolean   @default(false)
  isMember          Boolean   @default(false)
  inviteRequestedAt DateTime?
  classifiedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@id([organizationId, id])
  @@index([organizationId, available, name])
  @@index([updatedAt])
  @@map("slackChannel")
}

model SlackInstallation {
  botTokenHash String
  installerId  String
  teamId       String
  teamName     String?
  userToken    String?
  userScopes   String
  createdAt    DateTime @default(now())

  @@id([botTokenHash, installerId])
  @@index([createdAt])
  @@map("slackInstallation")
}

model SlackConnection {
  organizationId String       @id @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  teamId               String
  teamName             String?
  botToken             String
  botScopes            String
  installerSlackUserId String
  installedById        String?
  installedBy          User?    @relation("SlackConnectionInstaller", fields: [installedById], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([teamId])
  @@map("slackConnection")
}

model SlackWorkspaceGrant {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id         String   @id @default(cuid())
  teamId     String
  teamName   String?
  userToken  String
  userScopes String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([organizationId, teamId])
  @@map("slackWorkspaceGrant")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

enum McpConnectionStatus {
  CONNECTING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum McpAccessMode {
  READ_ONLY
  READ_WRITE
}

enum McpToolReviewState {
  PENDING
  REVIEWED
  CHANGED
  REMOVED
}

model McpConnection {
  id String @id @default(cuid())

  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  platformSlug  String
  status        McpConnectionStatus @default(CONNECTING)
  accessMode    McpAccessMode
  grantedScopes String[]

  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?

  registrationId String
  registration   McpClientRegistration @relation(fields: [registrationId], references: [id], onDelete: NoAction)

  connectedById String
  connectedBy   User   @relation("McpConnectionUser", fields: [connectedById], references: [id], onDelete: NoAction)

  connectedAt          DateTime?
  lastSuccessfulCallAt DateTime?
  lastErrorCode        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  toolSnapshots McpToolSnapshot[]

  @@unique([organizationId, platformSlug])
  @@index([status, updatedAt])
  @@map("mcpConnection")
}

model McpClientRegistration {
  id String @id @default(cuid())

  platformSlug                     String
  metadataFingerprint              String
  issuer                           String
  clientId                         String
  encryptedClientSecret            String?
  encryptedRegistrationAccessToken String?
  clientIdIssuedAt                 DateTime?
  clientSecretExpiresAt            DateTime?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  connections McpConnection[]
  oauthStates McpOauthState[]

  @@unique([platformSlug, metadataFingerprint])
  @@index([clientSecretExpiresAt])
  @@map("mcpClientRegistration")
}

model McpToolSnapshot {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id String @id @default(cuid())

  connectionId String
  connection   McpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  name        String
  description String?
  inputSchema Json
  annotations Json?
  fingerprint String
  callKind    String
  reviewState McpToolReviewState @default(PENDING)
  lastSeenAt  DateTime           @default(now())
  createdAt   DateTime           @default(now())

  @@unique([connectionId, name, fingerprint])
  @@index([connectionId, name, lastSeenAt])
  @@index([reviewState, lastSeenAt])
  @@index([organizationId])
  @@map("mcpToolSnapshot")
}

model McpOauthState {
  id String @id @default(cuid())

  stateHash      String       @unique
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("McpOauthStateUser", fields: [userId], references: [id], onDelete: Cascade)

  platformSlug          String
  accessMode            McpAccessMode
  returnPath            String
  encryptedCodeVerifier String
  registrationId        String
  registration          McpClientRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime              @default(now())

  @@index([expiresAt, consumedAt])
  @@map("mcpOauthState")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

enum StageOutcome {
  OPEN
  WON
  LOST
}

model Pipeline {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id       String  @id @default(cuid())
  name     String
  isActive Boolean @default(true)

  stages    PipelineStage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([organizationId], map: "pipeline_one_active_per_org", where: { isActive: true })
  @@index([organizationId])
  @@map("pipeline")
}

model PipelineStage {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  key         String
  label       String
  position    Int
  outcome     StageOutcome
  probability Int?
  isDefault   Boolean      @default(false)
  inWinRate   Boolean      @default(true)

  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipelineId, key])
  @@unique([pipelineId], map: "pipelineStage_one_default_per_pipeline", where: { isDefault: true })
  @@index([pipelineId, position])
  @@index([organizationId])
  @@map("pipelineStage")
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  STAGE_CHANGE
  ENRICHMENT
}

enum EnrichmentStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
  SKIPPED
}

enum RecordSource {
  MANUAL
  IMPORT
  EMAIL
  CALENDAR
  TRACKING
}

enum AgentConversationKind {
  RECORD
  BUILDER
}

enum AgentDefinitionStatus {
  DRAFT
  DEPLOYING
  LIVE
  PAUSED
  ARCHIVED
  DELETED
}

enum AgentVersionStatus {
  DRAFT
  VALIDATING
  READY
  DEPLOYED
  REJECTED
}

enum AgentBuilderArtifactStatus {
  WRITING
  READY
}

enum AgentTriggerType {
  MANUAL
  SCHEDULE
  EVENT
  WEBHOOK
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_FOR_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentActionStatus {
  PLANNED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentConversationShareScope {
  WORKSPACE_LINK
}

enum AgentConversationSubmissionStatus {
  PENDING
  SENDING
  ACCEPTED
  FAILED
  CANCELLED
}

enum AgentConversationCommandType {
  CHAT
  CREATE_AGENT
}

enum AgentConversationPermissionMode {
  MANUAL
  AUTO
  BYPASS
}

enum AgentResponseRating {
  UP
  DOWN
}

model Company {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id          String  @id @default(cuid())
  name        String
  domain      String?
  website     String?
  description String?

  logoUrl     String?
  logoDarkUrl String?
  iconUrl     String?
  iconDarkUrl String?
  iconTone    String?
  brandColor  String?

  industry    String?
  subIndustry String?
  city        String?
  stateCode   String?
  country     String?
  countryCode String?

  phone       String?
  email       String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  pricingUrl  String?
  careersUrl  String?

  ownerId          String?
  owner            User?    @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryContactId String?  @unique
  primaryContact   Contact? @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  enrichmentStatus EnrichmentStatus   @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?
  enrichment       CompanyEnrichment?
  researchResults  ResearchResult[]

  source RecordSource @default(MANUAL)

  lastActivityAt DateTime?
  archivedAt     DateTime?

  contacts       Contact[]           @relation("CompanyContacts")
  conversations  AgentConversation[]
  deals          Deal[]
  activities     Activity[]
  emailThreads   EmailThread[]
  calendarEvents CalendarEvent[]
  fieldValues    FieldValue[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, domain], map: "company_org_domain_active_key", where: { archivedAt: null })
  @@index([ownerId])
  @@index([name])
  @@index([lastActivityAt])
  @@index([archivedAt])
  @@index([organizationId])
  @@map("company")
}

model CompanyEnrichment {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyId String   @id
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    String   @default("context.dev")
  raw       Json
  fetchedAt DateTime @default(now())

  @@index([organizationId])
  @@map("companyEnrichment")
}

model Contact {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id          String  @id @default(cuid())
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  title       String?
  seniority   String?
  function    String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  imageUrl    String?

  socialsCheckedAt DateTime?

  enrichmentStatus EnrichmentStatus @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?

  brief           ContactBrief?
  facts           ContactFact[]
  researchResults ResearchResult[]
  conversations   AgentConversation[]

  companyId String?
  company   Company? @relation("CompanyContacts", fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String?
  owner     User?    @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryOf Company? @relation("PrimaryContact")

  source RecordSource @default(MANUAL)

  lastActivityAt DateTime?
  archivedAt     DateTime?

  deals           DealContact[]
  activities      Activity[]
  emailThreads    EmailThread[]
  calendarEvents  CalendarEvent[]
  eventAttendance CalendarAttendee[]
  fieldValues     FieldValue[]
  visitors        TrackedVisitor[]   @relation("VisitorContact")
  submissions     FormSubmission[]   @relation("SubmissionContact")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([organizationId, email], map: "contact_org_email_active_key", where: { archivedAt: null })
  @@index([companyId])
  @@index([ownerId])
  @@index([lastActivityAt])
  @@index([archivedAt])
  @@index([organizationId])
  @@map("contact")
}

enum FactBand {
  VERIFIED
  PROBABLE
  POSSIBLE
}

enum FactStatus {
  APPLIED
  PROPOSED
  DISMISSED
  SUPERSEDED
}

model ContactFact {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  field String
  value String

  score Float
  band  FactBand

  evidence Json

  method    String
  sourceUrl String?

  sessionId String?

  status      FactStatus @default(PROPOSED)
  decidedById String?
  decidedBy   User?      @relation("FactDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  observedAt   DateTime  @default(now())
  supersededAt DateTime?

  @@index([contactId, field, status])
  @@index([status, observedAt])
  @@index([organizationId])
  @@map("contactFact")
}

model ContactBrief {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String  @id
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  narrative String
  sections  Json

  score     Float
  sourceUrl String?
  sessionId String?

  refreshedAt DateTime @default(now())

  @@index([organizationId])
  @@map("contactBrief")
}

model AgentTask {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id        String  @id @default(cuid())
  contactId String?
  companyId String?
  dealId    String?

  kind    String
  reason  String
  payload Json?

  priority Int @default(0)
  budget   Int @default(4)
  attempts Int @default(0)

  dueAt       DateTime
  leasedUntil DateTime?

  sessionId  String?
  startedAt  DateTime?
  finishedAt DateTime?
  outcome    String?

  subject String?

  createdAt DateTime @default(now())

  @@index([dueAt, leasedUntil])
  @@index([contactId])
  @@index([dealId])
  @@index([kind, subject], where: { finishedAt: null })
  @@index([organizationId])
  @@map("agentTask")
}

model AgentEvent {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id             String             @id
  sessionId      String
  streamIndex    Int?
  deliveryIds    String[]           @default([])
  contactId      String?
  conversationId String?
  conversation   AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           String
  data           Json
  encryptedData  String?

  emittedAt DateTime

  @@unique([sessionId, streamIndex])
  @@index([sessionId, emittedAt])
  @@index([contactId, emittedAt])
  @@index([conversationId, emittedAt])
  @@index([organizationId])
  @@map("agentEvent")
}

model AgentConversation {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id String @id @default(cuid())

  kind AgentConversationKind @default(RECORD)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ConversationOwner", fields: [userId], references: [id], onDelete: Cascade)

  agentId String?
  agent   AgentDefinition? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  sessionId            String? @unique
  continuationToken    String?
  streamIndex          Int     @default(0)
  pendingInputRequests Json?

  permissionMode AgentConversationPermissionMode @default(MANUAL)

  title        String?
  messageCount Int     @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastMessageAt   DateTime  @default(now())
  lastAssistantAt DateTime?
  lastReadAt      DateTime?

  shares           AgentConversationShare[]
  submissions      AgentConversationSubmission[]
  feedback         AgentConversationFeedback[]
  events           AgentEvent[]
  createdVersions  AgentVersion[]                @relation("AgentVersionSourceConversation")
  builderArtifacts AgentBuilderArtifact[]

  @@index([contactId, lastMessageAt])
  @@index([companyId, lastMessageAt])
  @@index([dealId, lastMessageAt])
  @@index([userId, kind, lastMessageAt])
  @@index([agentId, lastMessageAt])
  @@index([organizationId])
  @@map("agentConversation")
}

model AgentConversationFeedback {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ConversationFeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)

  messageId String
  rating    AgentResponseRating

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, userId, messageId])
  @@index([conversationId, createdAt])
  @@index([organizationId])
  @@map("agentConversationFeedback")
}

model AgentConversationShare {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ConversationShareCreator", fields: [createdById], references: [id], onDelete: Cascade)

  scope     AgentConversationShareScope @default(WORKSPACE_LINK)
  tokenHash String                      @unique

  createdAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  @@unique([conversationId], map: "agentConversationShare_one_active_per_conversation", where: { revokedAt: null })
  @@index([conversationId, revokedAt])
  @@index([organizationId])
  @@map("agentConversationShare")
}

model AgentConversationSubmission {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  submittedById String
  submittedBy   User   @relation("ConversationSubmissionAuthor", fields: [submittedById], references: [id], onDelete: NoAction)

  clientRequestId String                            @unique
  inputRequestId  String?
  commandType     AgentConversationCommandType      @default(CHAT)
  message         Json
  status          AgentConversationSubmissionStatus @default(PENDING)
  attemptCount    Int                               @default(0)

  errorCode    String?
  errorMessage String?

  createdAt  DateTime  @default(now())
  sentAt     DateTime?
  acceptedAt DateTime?

  attachments AgentConversationAttachment[]

  @@unique([conversationId, inputRequestId])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
  @@index([organizationId])
  @@map("agentConversationSubmission")
}

model AgentConversationAttachment {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id String @id @default(cuid())

  submissionId String
  submission   AgentConversationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  name      String
  mediaType String
  size      Int
  content   Bytes
  position  Int

  createdAt DateTime @default(now())

  @@index([submissionId, position])
  @@index([organizationId])
  @@map("agentConversationAttachment")
}

model AgentDefinition {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id String @id @default(cuid())

  name        String
  description String?
  status      AgentDefinitionStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("AgentDefinitionCreator", fields: [createdById], references: [id], onDelete: NoAction)

  currentVersionId String?       @unique
  currentVersion   AgentVersion? @relation("CurrentAgentVersion", fields: [currentVersionId, id], references: [id, agentId], onDelete: Restrict)

  versions      AgentVersion[]      @relation("AgentVersions")
  triggers      AgentTrigger[]
  runs          AgentRun[]
  actions       AgentAction[]
  auditEvents   AgentAuditEvent[]
  conversations AgentConversation[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

