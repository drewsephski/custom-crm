  @@unique([slug])
  @@map("organization")
}

enum OnboardingBrandStatus {
  IDLE
  READY
  NOT_FOUND
  UNAVAILABLE
  FAILED
}

model OnboardingSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  step         String   @default("business-type")
  businessType String?
  goals        String[] @default([])
  businessName String?
  website      String?
  details      Json?

  brand         Json?
  brandStatus   OnboardingBrandStatus @default(IDLE)
  brandDomain   String?
  brandLookups  Int                   @default(0)
  brandLookupAt DateTime?

  presetKey       String?
  config          Json?
  configVersionId String?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId], map: "onboardingSession_one_open_per_user", where: { completedAt: null })
  @@index([userId])
  @@index([organizationId])
  @@map("onboardingSession")
}

enum ResearchStatus {
  RESERVED
  COMPLETE
  PARTIAL
  EMPTY
  FAILED
  REFUSED
}

enum ResearchReview {
  NONE
  SUGGESTED
  ACCEPTED
  DISMISSED
  VERIFIED
}

model ResearchResult {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  task       String
  provider   String
  operation  String
  requestKey String

  status   ResearchStatus @default(RESERVED)
  partial  Boolean        @default(false)
  cacheHit Boolean        @default(false)

  findings   Json?
  sources    Json   @default("[]")
  confidence Float?
  match      Json?

  review       ResearchReview @default(NONE)
  reviewedById String?
  reviewedAt   DateTime?

  creditsReserved Int     @default(0)
  creditsUsed     Int     @default(0)
  attempts        Int     @default(0)
  error           String?

  userId    String?
  sessionId String?
  taskId    String?

  retrievedAt DateTime?
  expiresAt   DateTime?
  settledAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([organizationId, provider, operation, requestKey], map: "researchResult_one_in_flight", where: { settledAt: null })
  @@index([organizationId, createdAt])
  @@index([organizationId, provider, operation, requestKey, createdAt])
  @@index([organizationId, userId, createdAt])
  @@index([companyId])
  @@index([contactId])
  @@map("researchResult")
}

model PlatformResearchUsage {
  period   String
  provider String

  creditsReserved Int @default(0)
  creditsUsed     Int @default(0)
  requests        Int @default(0)
  cacheHits       Int @default(0)

  updatedAt DateTime @updatedAt

  @@id([period, provider])
  @@map("platformResearchUsage")
}

model ProviderCache {
  provider  String
  operation String
  key       String

  response Json
  credits  Int  @default(0)

  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@id([provider, operation, key])
  @@index([expiresAt])
  @@map("providerCache")
}

model WorkspaceProfile {
  organizationId String       @id @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  website   String
  narrative String
  sections  Json

  sourceUrl String?
  sessionId String?

  refreshedAt DateTime @default(now())

  @@map("workspaceProfile")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model SsoProvider {
  id             String  @id
  issuer         String
  oidcConfig     String?
  samlConfig     String?
  userId         String?
  user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId     String
  organizationId String?
  domain         String

  @@unique([providerId])
  @@map("ssoProvider")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  user                User      @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([referenceId])
  @@index([configId])
  @@index([key])
  @@map("apikey")
}

enum WorkspaceConfigStatus {
  GENERATING
  PROPOSED
  APPLIED
  SUPERSEDED
  FAILED
}

enum WorkspaceConfigSource {
  TEMPLATE
  AI
}

model WorkspaceConfigVersion {
  organizationId String       @default(dbgenerated("crm_current_org()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  id      String                @id @default(cuid())
  version Int
  status  WorkspaceConfigStatus
  source  WorkspaceConfigSource

  profile Json
  config  Json?
  error   String?

  createdById String?
  appliedById String?
  appliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([organizationId, version])
  @@index([organizationId, status])
  @@map("workspaceConfigVersion")
}
