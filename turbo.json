{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalEnv": ["NODE_ENV"],
	"globalPassThroughEnv": [
		"DATABASE_URL",
		"DATABASE_URL_UNPOOLED",
		"DATABASE_POOL_MAX",
		"DATABASE_POOL_IDLE_TIMEOUT_MS",
		"DATABASE_POOL_CONNECT_TIMEOUT_MS",
		"DEV_DATABASE_HOSTS",
		"ALLOW_REMOTE_DB",
		"NEON_BRANCH",
		"TEST_DATABASE_URL",
		"TEST_RUN_ID",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"ALLOWED_SIGN_IN",
		"AUTH_EMAIL_PASSWORD",
		"SEED_OWNER_EMAIL",
		"GOOGLE_CLIENT_ID",
		"GOOGLE_CLIENT_SECRET",
		"MICROSOFT_CLIENT_ID",
		"MICROSOFT_CLIENT_SECRET",
		"SLACK_CLIENT_ID",
		"SLACK_CLIENT_SECRET",
		"MICROSOFT_TENANT_ID",
		"AUTH_COOKIE_DOMAIN",
		"CRON_SECRET",
		"REDIS_URL",
		"CACHE_TTL_MS",
		"PORT",
		"PRISMA_LOG_QUERIES",
		"PERPLEXITY_API_KEY",
		"CONTEXT_DEV_API_KEY",
		"RESEARCH_WORKSPACE_MONTHLY_CREDITS",
		"RESEARCH_PLATFORM_MONTHLY_CREDITS",
		"RESEND_API_KEY",
		"EMAIL_FROM",
		"CRON_TARGET_URL",
		"GITHUB_TOKEN",
		"BLOB_READ_WRITE_TOKEN",
		"AWS_ENDPOINT_URL_S3",
		"AWS_ACCESS_KEY_ID",
		"AWS_SECRET_ACCESS_KEY",
		"AWS_REGION",
		"S3_PUBLIC_BUCKET",
		"NEON_REALTIME_URL",
		"NEON_REALTIME_SECRET",
		"ANTHROPIC_API_KEY",
		"ANTHROPIC_MODEL",
		"ANTHROPIC_COMPLEX_MODEL",
		"VERCEL_OIDC_TOKEN",
		"AGENT_URL",
		"AGENT_BRIDGE_SECRET",
		"MCP_ENCRYPTION_KEY",
		"CHAT_EVENT_ENCRYPTION_KEY",
		"CRM_TELEMETRY_DISABLED",
		"DO_NOT_TRACK",
		"VERCEL",
		"VERCEL_GIT_COMMIT_SHA"
	],

	"tasks": {
		"topo": {
			"dependsOn": ["^topo"]
		},
		"build": {
			"dependsOn": ["^build"],
			"env": ["API_URL", "APP_URL", "NEXT_PUBLIC_API_URL"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [
				".next/**",
				"!.next/cache/**",
				"!.next/dev/**",
				"dist/**",
				".output/**"
			]
		},
		"lint": {
			"dependsOn": ["topo"]
		},
		"check-types": {
			"dependsOn": ["topo", "^build"]
		},
		"test": {
			"dependsOn": ["topo", "^build"]
		},
		"dev": {
			"dependsOn": ["^dev:prepare"],
			"cache": false,
			"persistent": true
		},
		"dev:headless": {
			"dependsOn": ["^dev:prepare"],
			"cache": false,
			"persistent": true
		},
		"dev:prepare": {
			"cache": false
		}
	}
}
